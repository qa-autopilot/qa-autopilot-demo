# Copy to .env for local runs. Never commit .env.
# In CI these come from GitHub Actions secrets with the same names.

# Which build to test: baseline | with-bugs | v4 | v3 | local
TARGET=baseline

# Toolshop's seeded demo customer. The public values are in the
# Toolshop README: https://github.com/roydekleijn/practice-software-testing
TOOLSHOP_CUSTOMER_EMAIL=
TOOLSHOP_CUSTOMER_PASSWORD=

# Only for TARGET=local (docker compose copy)
# LOCAL_WEB_URL=http://localhost:4200
# LOCAL_API_URL=http://localhost:8091
