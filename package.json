{
  "name": "qa-autopilot-demo",
  "version": "0.1.0",
  "private": true,
  "description": "QA Autopilot showcase: nightly Playwright suite with AI failure triage, run against the Toolshop practice app.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:baseline": "cross-env TARGET=baseline playwright test",
    "test:with-bugs": "cross-env TARGET=with-bugs playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
